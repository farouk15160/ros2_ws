<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="use_mock_hardware" default="false" />

    <ros2_control name="VisionaSystem" type="system">
        <hardware>
            <xacro:if value="$(arg use_mock_hardware)">
                <plugin>mock_components/GenericSystem</plugin>
                <!-- Mock supports position interfacing natively -->
            </xacro:if>
            <xacro:unless value="$(arg use_mock_hardware)">
                <plugin>mock_components/GenericSystem</plugin>
            </xacro:unless>
        </hardware>

        <joint name="base_link_joint">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="link_1_shoulder_joint">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <param name="initial_position">1.57</param>
        </joint>

        <joint name="link_2_elbow_joint">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <param name="initial_position">1.57</param>
        </joint>

        <joint name="link_3_wrist_joint">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <param name="initial_position">1.57</param>
        </joint>

        <joint name="link_3_wrist_to_gripper_base_joint">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <param name="initial_position">1.57</param>
        </joint>

        <joint name="gripper">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>





    </ros2_control>

</robot>